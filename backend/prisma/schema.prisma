generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                        @id @default(uuid()) @map("user_id")
  username                     String                        @unique @db.VarChar(255)
  phone                        String?                       @unique
  email                        String                        @unique @db.VarChar(320)
  passwordHash                 String                        @map("password_hash")
  role                         Role                          @default(USER)
  plan                         Plan                          @default(FREE)
  isActive                     Boolean                       @default(true) @map("is_active")
  mfaEnabled                   Boolean                       @default(false) @map("mfa_enabled")
  mfaSecret                    String?                       @map("mfa_secret")
  failedLoginAttempts          Int                           @default(0) @map("failed_login_attempts")
  accountLockedUntil           DateTime?                     @map("account_locked_until")
  preferredLanguage            String?                       @map("preferred_language")
  nickname                     String?                       @default("") @db.VarChar(50)
  bio                          String?                       @default("") @db.VarChar(500)
  avatarKey                    String?                       @db.VarChar(255)
  avatarUpdatedAt              DateTime?
  lastLoginAt                  DateTime?                     @map("last_login_at")
  lastLoginIp                  String?                       @map("last_login_ip")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  deletedAt                    DateTime?                     @map("deleted_at")
  agents                       Agent[]                       @relation("UserToAgent")
  agentKnowledgeObjects        AgentKnowledgeObject[]
  conversations                Conversation[]
  userAgents                   UserAgent[]
  runtimeObjects               RuntimeObject[]
  packageArtifacts             PackageArtifact[]
  codePatchRuns                CodePatchRun[]
  workflowRuns                 WorkflowRun[]                 @relation("WorkflowRunUser")
  ownedSkills                  Skill[]                       @relation("SkillOwner")
  createdSkills                Skill[]                       @relation("SkillCreator")
  createdSkillVersions         SkillVersion[]                @relation("SkillVersionCreator")
  skillInstallations           SkillInstallation[]           @relation("SkillInstaller")
  skillValidationRuns          SkillValidationRun[]          @relation("SkillValidationRequester")
  skillUsageEvents             SkillUsageEvent[]             @relation("SkillUsageUser")
  skillAuditLogs               SkillAuditLog[]               @relation("SkillAuditActor")
  conversationSkillActivations ConversationSkillActivation[] @relation("ConversationSkillActivator")
  localAccount                 LocalAccount?
  llmCredentials               UserLlmCredential[]
  llmPreference                UserLlmPreference?
  webSearchSetting             UserWebSearchSetting?
  mcpGloballyEnabled           Boolean                       @default(true) @map("mcp_globally_enabled")
  voiceAssets                  UserVoiceAsset[]
  ownedMcpDefinitions          McpServerConfig[]             @relation("McpDefinitionOwner")
  mcpInstallations             McpInstallation[]
  mcpCredentials               McpCredential[]

  @@index([email], map: "idx_user_email")
  @@index([username], map: "idx_user_username")
  @@index([createdAt], map: "idx_user_created_at")
}

model LocalAccount {
  key                   String    @id @default("primary") @db.VarChar(32)
  userId                String?   @unique @map("user_id")
  sessionId             String?   @map("session_id") @db.VarChar(36)
  refreshTokenHash      String?   @map("refresh_token_hash") @db.VarChar(64)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  initializedAt         DateTime? @map("initialized_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("local_account")
}

model Agent {
  id                     String           @id @default(uuid())
  name                   String
  entityType             SeekmoreEntityType @default(COGNITIVE) @map("entity_type")
  visibility             AgentVisibility  @default(PRIVATE)
  isActive               Boolean          @default(true)
  approved               Boolean          @default(true)
  deletedAt              DateTime?
  purgeAfter             DateTime?        @map("purge_after")
  isTemplate             Boolean          @default(false)
  avatarKey              String?          @db.VarChar(255)
  avatarUpdatedAt        DateTime?
  coverKey               String?          @db.VarChar(255)
  coverUpdatedAt         DateTime?
  userId                 String?
  key                    String?          @unique
  systemPrompt           String           @default("")
  rolePrompt             String?          @map("role_prompt")
  isSuper                Boolean          @default(false)
  capabilities           String[]         @default([])
  description            String?
  downloads              Int              @default(0)
  likes                  Int              @default(0)
  tags                   String[]         @default([])
  capabilityProfile      Json?            @map("capability_profile")
  capabilityJson         Json?            @map("capability_json")
  knowledgeEnabled       Boolean          @default(true) @map("knowledge_enabled")
  memoryEnabled          Boolean          @default(true) @map("memory_enabled")
  toolEnabled            Boolean          @default(true) @map("tool_enabled")
  runtimeProfileId       String?          @map("runtime_profile_id") @db.VarChar(120)
  publishedAt            DateTime?        @map("published_at")
  verifiedAt             DateTime?        @map("verified_at")
  defaultImageProviderId String?          @map("default_image_provider_id") @db.VarChar(120)
  defaultVoiceProviderId String?          @map("default_voice_provider_id") @db.VarChar(120)
  riskLevel              String?          @default("medium") @map("risk_level")
  llmTemperature         Float?
  llmExtra               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user             User?                        @relation("UserToAgent", fields: [userId], references: [id])
  conversations    Conversation[]               @relation("AgentConversations")
  userAgents       UserAgent[]
  knowledgeObjects AgentKnowledgeObject[]
  cognitiveProfile CognitiveAgentProfile?
  serviceProfile   ServiceAgentProfile?
  runtimeObjects   RuntimeObject[]
  packageArtifacts PackageArtifact[]
  codePatchRuns    CodePatchRun[]
  workflowRuns     WorkflowRun[]                @relation("WorkflowRunAgent")
  skillPolicy      CognitiveAgentSkillPolicy?
  skillBindings    CognitiveAgentSkillBinding[]
  skillUsageEvents SkillUsageEvent[]

  @@index([userId])
  @@index([entityType], map: "idx_agent_entity_type")
  @@index([visibility, approved, isActive])
  @@index([publishedAt], map: "idx_agent_published_at")
  @@index([verifiedAt], map: "idx_agent_verified_at")
  @@index([deletedAt])
  @@index([purgeAfter], map: "idx_agent_purge_after")
}


model MemoryFact {
  id String @id @default(uuid())

  tenantId       String? @map("tenant_id")
  orgId          String? @map("org_id")
  groupId        String? @map("group_id")
  planId         String? @map("plan_id")
  projectId      String? @map("project_id")
  userId         String  @map("user_id")
  agentId        String? @map("agent_id")
  conversationId String? @map("conversation_id")

  scopeLevel String @map("scope_level") @db.VarChar(32)

  kind String @db.VarChar(64)

  subject   String @db.VarChar(240)
  predicate String @db.VarChar(160)
  valueJson Json   @map("value_json")

  summary    String @db.Text
  searchText String @map("search_text") @db.Text

  status String @default("active") @db.VarChar(32)

  confidence  Float  @default(0)
  stability   String @db.VarChar(32)
  sensitivity String @default("normal") @db.VarChar(32)

  evidenceSource           String  @map("evidence_source") @db.VarChar(64)
  sourceConversationId     String? @map("source_conversation_id")
  sourceMessageId          String? @map("source_message_id")
  sourceAssistantMessageId String? @map("source_assistant_message_id")
  sourceTraceId            String? @map("source_trace_id") @db.VarChar(128)
  sourceQuote              String? @map("source_quote") @db.Text
  sourceHash               String? @map("source_hash") @db.VarChar(128)

  validFrom  DateTime  @default(now()) @map("valid_from")
  validTo    DateTime? @map("valid_to")
  lastUsedAt DateTime? @map("last_used_at")
  usageCount Int       @default(0) @map("usage_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outgoingRelations MemoryRelation[]  @relation("MemoryRelationFrom")
  incomingRelations MemoryRelation[]  @relation("MemoryRelationTo")
  embeddings        MemoryEmbedding[]

  @@index([userId, status, scopeLevel, kind], map: "idx_memory_fact_user_status_scope_kind")
  @@index([userId, agentId, status], map: "idx_memory_fact_user_agent_status")
  @@index([userId, conversationId, status], map: "idx_memory_fact_user_conversation_status")
  @@index([userId, projectId, status], map: "idx_memory_fact_user_project_status")
  @@index([tenantId, orgId, userId], map: "idx_memory_fact_tenant_org_user")
  @@index([sourceConversationId, sourceMessageId], map: "idx_memory_fact_source_message")
  @@index([sourceHash], map: "idx_memory_fact_source_hash")
  @@index([status, updatedAt], map: "idx_memory_fact_status_updated")
  @@map("memory_fact")
}

model MemoryEpisode {
  id String @id @default(uuid())

  tenantId       String? @map("tenant_id")
  orgId          String? @map("org_id")
  groupId        String? @map("group_id")
  planId         String? @map("plan_id")
  projectId      String? @map("project_id")
  userId         String  @map("user_id")
  agentId        String? @map("agent_id")
  conversationId String? @map("conversation_id")

  sourceConversationId     String? @map("source_conversation_id")
  sourceUserMessageId      String? @map("source_user_message_id")
  sourceAssistantMessageId String? @map("source_assistant_message_id")
  sourceTraceId            String? @map("source_trace_id") @db.VarChar(128)

  userText      String? @map("user_text") @db.Text
  assistantText String? @map("assistant_text") @db.Text
  summary       String? @db.Text

  status String @default("active") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, conversationId, createdAt], map: "idx_memory_episode_user_conversation_time")
  @@index([sourceConversationId, sourceUserMessageId], map: "idx_memory_episode_source_user_message")
  @@index([tenantId, orgId, userId], map: "idx_memory_episode_tenant_org_user")
  @@index([status, createdAt], map: "idx_memory_episode_status_time")
  @@map("memory_episode")
}

model MemoryRelation {
  id String @id @default(uuid())

  tenantId  String? @map("tenant_id")
  orgId     String? @map("org_id")
  userId    String  @map("user_id")
  projectId String? @map("project_id")

  fromMemoryId String @map("from_memory_id")
  toMemoryId   String @map("to_memory_id")

  relationKind String @map("relation_kind") @db.VarChar(64)
  confidence   Float  @default(0)

  status String @default("active") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromMemory MemoryFact @relation("MemoryRelationFrom", fields: [fromMemoryId], references: [id], onDelete: Cascade)
  toMemory   MemoryFact @relation("MemoryRelationTo", fields: [toMemoryId], references: [id], onDelete: Cascade)

  @@index([userId, fromMemoryId], map: "idx_memory_relation_user_from")
  @@index([userId, toMemoryId], map: "idx_memory_relation_user_to")
  @@index([projectId, relationKind], map: "idx_memory_relation_project_kind")
  @@index([status], map: "idx_memory_relation_status")
  @@map("memory_relation")
}

model MemoryEmbedding {
  id String @id @default(uuid())

  memoryId String @map("memory_id")

  provider   String @db.VarChar(64)
  model      String @db.VarChar(120)
  dimensions Int

  vectorJson Json @map("vector_json")

  createdAt DateTime @default(now()) @map("created_at")

  memory MemoryFact @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId], map: "idx_memory_embedding_memory")
  @@index([provider, model], map: "idx_memory_embedding_provider_model")
  @@map("memory_embedding")
}

model MemoryAudit {
  id String @id @default(uuid())

  tenantId       String? @map("tenant_id")
  orgId          String? @map("org_id")
  groupId        String? @map("group_id")
  planId         String? @map("plan_id")
  projectId      String? @map("project_id")
  userId         String  @map("user_id")
  agentId        String? @map("agent_id")
  conversationId String? @map("conversation_id")

  action String @db.VarChar(64)

  memoryId    String? @map("memory_id")
  payloadJson Json?   @map("payload_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_memory_audit_user_time")
  @@index([memoryId], map: "idx_memory_audit_memory")
  @@index([action, createdAt], map: "idx_memory_audit_action_time")
  @@index([tenantId, orgId, userId], map: "idx_memory_audit_tenant_org_user")
  @@map("memory_audit")
}

model UserAgent {
  id                String           @id @default(uuid())
  userId            String
  agentId           String
  accessLevel       AgentAccessLevel @default(OWNER)
  remark            String?
  pinnedAt          DateTime?
  removedFromChatAt DateTime?        @map("removed_from_chat_at")
  deletedAt         DateTime?
  isDefaultAgent    Boolean          @default(false) @map("is_default_agent")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  agent             Agent            @relation(fields: [agentId], references: [id])
  user              User             @relation(fields: [userId], references: [id])

  @@unique([agentId, userId], map: "uq_agent_user")
  @@index([userId])
  @@index([agentId])
  @@index([pinnedAt])
  @@index([removedFromChatAt], map: "idx_user_agent_removed_chat")
  @@index([deletedAt])
  @@index([userId, isDefaultAgent], map: "idx_user_default_agent")
}

model AgentKnowledgeObject {
  id             String               @id @default(cuid())
  agentId        String               @map("agent_id")
  userId         String               @map("user_id")
  originalName   String               @map("original_name") @db.VarChar(255)
  storedName     String               @map("stored_name") @db.VarChar(255)
  mimeType       String               @map("mime_type") @db.VarChar(120)
  extension      String?              @map("extension") @db.VarChar(32)
  sizeBytes      Int                  @map("size_bytes")
  sha256         String?              @map("sha256") @db.VarChar(64)
  storageKey     String               @map("storage_key") @db.VarChar(500)
  parseStatus    KnowledgeParseStatus @default(PENDING) @map("parse_status")
  parseError     String?              @map("parse_error")
  chunkCount     Int?                 @map("chunk_count")
  embeddingModel String?              @map("embedding_model") @db.VarChar(120)
  meta           Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  agent  Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks AgentKnowledgeChunk[]

  @@index([agentId], map: "idx_agent_knowledge_agent")
  @@index([userId], map: "idx_agent_knowledge_user")
  @@index([parseStatus], map: "idx_agent_knowledge_parse_status")
  @@index([deletedAt], map: "idx_agent_knowledge_deleted_at")
  @@map("agent_knowledge_object")
}

model AgentKnowledgeChunk {
  id             String                 @id @default(cuid())
  objectId       String                 @map("object_id")
  agentId        String                 @map("agent_id")
  userId         String                 @map("user_id")
  chunkIndex     Int                    @map("chunk_index")
  content        String
  tokenCount     Int?                   @map("token_count")
  embedding      Unsupported("vector")?
  embeddingModel String?                @map("embedding_model") @db.VarChar(120)
  meta           Json?
  createdAt      DateTime               @default(now()) @map("created_at")

  object AgentKnowledgeObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, chunkIndex], map: "uq_agent_knowledge_chunk_object_index")
  @@index([objectId], map: "idx_agent_knowledge_chunk_object")
  @@index([agentId], map: "idx_agent_knowledge_chunk_agent")
  @@index([userId], map: "idx_agent_knowledge_chunk_user")
  @@map("agent_knowledge_chunk")
}


model RuntimeObject {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  agentId        String @map("origin_agent_id")
  conversationId String @map("origin_conversation_id")

  originalName String @map("original_name") @db.VarChar(500)
  displayName  String @map("display_name") @db.VarChar(500)
  baseName     String @map("base_name") @db.VarChar(500)
  extension    String @default("") @db.VarChar(64)
  mimeType     String @map("mime_type") @db.VarChar(160)
  sizeBytes    BigInt @map("size_bytes")

  contentHash       String @map("content_hash") @db.VarChar(64)
  duplicateGroupKey String @map("duplicate_group_key") @db.VarChar(512)
  versionNo         Int    @default(0) @map("version_no")

  storageKey String @map("storage_key") @db.VarChar(1000)

  objectKind String @map("object_kind") @db.VarChar(32)

  originType String @map("origin_type") @db.VarChar(32)
  visibility String @map("visibility") @db.VarChar(32)

  status String @default("available") @map("upload_status") @db.VarChar(32)

  metadata Json? @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)

  messageLinks MessageObjectLink[]

  @@unique([duplicateGroupKey, versionNo], map: "uq_runtime_object_partition_name_version")
  @@index([userId, extension, baseName], map: "idx_runtime_object_user_extension_name")
  @@index([userId, agentId, conversationId, createdAt], map: "idx_runtime_object_partition_created")
  @@index([userId, agentId, conversationId, objectKind], map: "idx_runtime_object_partition_kind")
  @@index([userId, agentId, conversationId, visibility, objectKind, createdAt], map: "idx_runtime_object_partition_visibility_kind_created")
  @@index([contentHash], map: "idx_runtime_object_content_hash")
  @@index([deletedAt], map: "idx_runtime_object_deleted_at")
  @@map("runtime_object")
}

model StorageDeletionTask {
  id               String    @id @default(cuid())
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(64)
  storageKind      String    @map("storage_kind") @db.VarChar(32)
  storageKey       String    @map("storage_key") @db.VarChar(1000)
  sourceType       String    @map("source_type") @db.VarChar(64)
  sourceId         String    @map("source_id") @db.VarChar(180)
  status           String    @default("pending") @db.VarChar(32)
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at")
  claimedAt        DateTime? @map("claimed_at")
  lastError        String?   @map("last_error") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt], map: "idx_storage_deletion_task_pending")
  @@index([sourceType, sourceId], map: "idx_storage_deletion_task_source")
  @@index([claimedAt], map: "idx_storage_deletion_task_claimed")
  @@map("storage_deletion_task")
}

enum MessageObjectRole {
  USER_INPUT
  ASSISTANT_OUTPUT
}

model MessageObjectLink {
  id        String            @id @default(cuid())
  messageId String            @map("message_id")
  objectId  String            @map("object_id")
  role      MessageObjectRole
  position  Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at")

  message Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  object  RuntimeObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([messageId, objectId, role], map: "uq_message_object_link_message_object_role")
  @@unique([messageId, role, position], map: "uq_message_object_link_message_role_position")
  @@index([messageId, role], map: "idx_message_object_link_message_role")
  @@index([objectId], map: "idx_message_object_link_object")
  @@map("message_object_link")
}

model CodeProjectProfile {
  id                  String              @id @default(cuid())
  objectId            String              @map("object_id")
  userId              String              @map("user_id")
  agentId             String?             @map("agent_id")
  conversationId      String?             @map("conversation_id")
  versionNo           Int                 @default(1) @map("version_no")
  isActive            Boolean             @default(true) @map("is_active")
  projectKind         String              @map("project_kind") @db.VarChar(64)
  languageSetJson     Json                @map("language_set_json")
  objectCount         Int                 @default(0) @map("object_count")
  indexedObjectCount  Int                 @default(0) @map("indexed_object_count")
  ignoredObjectCount  Int                 @default(0) @map("ignored_object_count")
  structureJson       Json                @map("structure_json")
  dependencyGraphJson Json?               @map("dependency_graph_json")
  summary             String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  objects             CodeProjectObject[]
  symbols             CodeSymbol[]
  patchRuns           CodePatchRun[]

  @@unique([objectId, versionNo], map: "uq_code_project_profile_object_version")
  @@index([objectId], map: "idx_code_project_profile_object")
  @@index([objectId, isActive], map: "idx_code_project_profile_object_active")
  @@map("code_project_profile")
}

model CodeProjectObject {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  objectId  String?  @map("object_id")
  path      String   @db.VarChar(1000)
  language  String   @db.VarChar(64)
  sizeBytes BigInt   @default(0) @map("size_bytes")
  lineCount Int      @default(0) @map("line_count")
  hash      String?  @db.VarChar(64)
  role      String   @default("source") @db.VarChar(32)
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")

  project CodeProjectProfile @relation(fields: [projectId], references: [id], onDelete: Cascade)
  symbols CodeSymbol[]

  @@unique([projectId, path], map: "uq_code_project_object_project_path")
  @@index([projectId], map: "idx_code_project_object_project")
  @@index([language], map: "idx_code_project_object_language")
  @@map("code_project_object")
}

model CodeSymbol {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  projectObjectId String   @map("project_object_id")
  objectPath      String   @map("object_path") @db.VarChar(1000)
  name            String   @db.VarChar(255)
  kind            String   @db.VarChar(64)
  lineStart       Int      @map("line_start")
  lineEnd         Int      @map("line_end")
  exported        Boolean  @default(false)
  signature       String?
  metadataJson    Json?    @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")

  project       CodeProjectProfile @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectObject CodeProjectObject  @relation(fields: [projectObjectId], references: [id], onDelete: Cascade)

  @@index([projectId, name], map: "idx_code_symbol_project_name")
  @@index([projectId, objectPath], map: "idx_code_symbol_project_object_path")
  @@index([projectObjectId], map: "idx_code_symbol_project_object")
  @@index([kind], map: "idx_code_symbol_kind")
  @@map("code_symbol")
}

model CodePatchRun {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  agentId            String?   @map("agent_id")
  conversationId     String?   @map("conversation_id")
  messageId          String?   @map("message_id")
  projectId          String    @map("project_id")
  sourceObjectId     String?   @map("source_object_id")
  instruction        String
  status             String    @default("planned") @db.VarChar(32)
  patchPlanJson      Json      @map("patch_plan_json")
  appliedChangesJson Json?     @map("applied_changes_json")
  validationJson     Json?     @map("validation_json")
  packageArtifactId  String?   @map("package_artifact_id")
  errorCode          String?   @map("error_code") @db.VarChar(120)
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  startedAt          DateTime? @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
