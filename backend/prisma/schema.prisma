model Skill {
  id              String  @id @default(uuid())
  ownerUserId     String? @map("owner_user_id")
  createdByUserId String  @map("created_by_user_id")
  namespaceKey    String  @map("namespace_key") @db.VarChar(240)
  tenantId        String? @map("tenant_id") @db.VarChar(120)
  organizationId  String? @map("organization_id") @db.VarChar(120)

  name                  String @db.VarChar(120)
  displayName           String @map("display_name") @db.VarChar(120)
  slug                  String @db.VarChar(64)
  description           String @db.VarChar(1024)
  activationDescription String @map("activation_description") @db.VarChar(1024)

  status                SkillStatus         @default(DRAFT)
  visibility            SkillVisibility     @default(PRIVATE)
  trustLevel            SkillTrustLevel     @default(USER) @map("trust_level")
  securityState         SkillSecurityState  @default(REVIEW_REQUIRED) @map("security_state")
  defaultActivationMode SkillActivationMode @default(AUTOMATIC) @map("default_activation_mode")

  category  String?  @db.VarChar(80)
  tags      String[] @default([])
  platforms String[] @default([])
  iconKey   String?  @map("icon_key") @db.VarChar(500)
  coverKey  String?  @map("cover_key") @db.VarChar(500)

  currentVersionId String?       @unique @map("current_version_id")
  currentVersion   SkillVersion? @relation("SkillCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  revision         Int           @default(1)

  useCount         BigInt    @default(0) @map("use_count")
  lastUsedAt       DateTime? @map("last_used_at")
  lastValidatedAt  DateTime? @map("last_validated_at")
  staleAt          DateTime? @map("stale_at")
  archivedAt       DateTime? @map("archived_at")
  quarantinedAt    DateTime? @map("quarantined_at")
  quarantineReason String?   @map("quarantine_reason") @db.Text
  pinned           Boolean   @default(false)
  growEnabled      Boolean   @default(true) @map("grow_enabled")
  growLocked       Boolean   @default(false) @map("grow_locked")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  purgeAfter DateTime? @map("purge_after")

  owner     User? @relation("SkillOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy User  @relation("SkillCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  source                  SkillSource?
  versions                SkillVersion[]                @relation("SkillVersions")
  dependenciesOnMe        SkillDependency[]             @relation("SkillDependencyTarget")
  agentBindings           CognitiveAgentSkillBinding[]
  installations           SkillInstallation[]
  conversationActivations ConversationSkillActivation[]
  aclEntries              SkillAclEntry[]
  usageEvents             SkillUsageEvent[]
  auditLogs               SkillAuditLog[]

  @@unique([namespaceKey, slug], map: "uq_skill_namespace_slug")
  @@index([ownerUserId, status], map: "idx_skill_owner_status")
  @@index([organizationId, visibility, status], map: "idx_skill_org_visibility_status")
  @@index([tenantId, status], map: "idx_skill_tenant_status")
  @@index([trustLevel, securityState], map: "idx_skill_trust_security")
  @@index([category], map: "idx_skill_category")
  @@index([tags], type: Gin, map: "idx_skill_tags_gin")
  @@index([platforms], type: Gin, map: "idx_skill_platforms_gin")
  @@index([lastUsedAt], map: "idx_skill_last_used")
  @@index([deletedAt], map: "idx_skill_deleted")
  @@index([purgeAfter], map: "idx_skill_purge_after")
  @@map("skill")
}

