  connectionStates McpConnectionState[]
  invocations      McpToolInvocation[]

  @@unique([userId, serverId], map: "uq_mcp_installation_user_server")
  @@index([userId, enabled, status], map: "idx_mcp_installation_user_state")
  @@index([serverId, status], map: "idx_mcp_installation_server_state")
}

model McpCredential {
  id               String   @id @default(cuid())
  installationId   String   @unique @map("installation_id")
  userId           String   @map("user_id")
  kind             String
  storageLocation  String   @map("storage_location")
  encryptedPayload Bytes?   @map("encrypted_payload")
  encryptionIv     Bytes?   @map("encryption_iv")
  authTag          Bytes?   @map("auth_tag")
  secretRef        String?  @map("secret_ref")
  keyVersion       Int      @default(1) @map("key_version")
  maskedHint       String?  @map("masked_hint")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  installation McpInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind], map: "idx_mcp_credential_user_kind")
}

model McpAuthSession {
  id               String    @id @default(cuid())
  serverId         String
  tenantId         String?   @default("")
  userId           String
  agentId          String?   @default("")
  status           String    @default("active")
  authKind         String
  accessToken      String? // legacy read-only fallback; new writes are encrypted
  refreshToken     String? // legacy read-only fallback; new writes are encrypted
  encryptedPayload Bytes?    @map("encrypted_payload")
  encryptionIv     Bytes?    @map("encryption_iv")
  authTag          Bytes?    @map("auth_tag")
  keyVersion       Int       @default(1) @map("key_version")
  tokenType        String?
  scope            String?
  expiresAt        DateTime?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  server McpServerConfig @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, tenantId, userId, agentId], name: "serverId_tenantId_userId_agentId")
  @@index([serverId, status])
  @@index([userId])
}

model McpOAuthState {
  id                    String   @id @default(cuid())
  serverId              String
  tenantId              String?
  userId                String
  agentId               String?
  state                 String   @unique
  codeVerifier          String? // legacy read-only fallback; new writes are encrypted
  encryptedCodeVerifier Bytes?   @map("encrypted_code_verifier")
  codeVerifierIv        Bytes?   @map("code_verifier_iv")
  codeVerifierAuthTag   Bytes?   @map("code_verifier_auth_tag")
  keyVersion            Int      @default(1) @map("key_version")
  redirectUri           String
  expiresAt             DateTime
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())

  @@index([serverId])
  @@index([expiresAt])
}

model McpConnectionState {
  id                 String    @id @default(cuid())
  identityHash       String    @unique
  serverId           String
  installationId     String?   @map("installation_id")
  tenantId           String?
  userId             String?
  agentId            String?
  authSessionId      String?
  scope              String
  status             String
  failureCode        String?
  failureMessage     String?
  protocolEra        String?   @map("protocol_era")
  protocolVersion    String?   @map("protocol_version")
  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?
  lastHealthCheckAt  DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  server       McpServerConfig  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  installation McpInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([installationId, status])
  @@index([tenantId, userId, agentId])
}

model McpToolSnapshot {
  id             String   @id @default(cuid())
  runtimeToolId  String   @unique
  serverId       String
  installationId String?  @map("installation_id")
  serverName     String
  toolName       String
  title          String?
  description    String?
  inputSchema    Json     @default("{}")
  outputSchema   Json?
  annotations    Json?
  snapshotHash   String
  status         String   @default("available")
  discoveredAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  server       McpServerConfig     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  installation McpInstallation?    @relation(fields: [installationId], references: [id], onDelete: Cascade)
  invocations  McpToolInvocation[]

  @@unique([installationId, toolName], map: "uq_mcp_snapshot_installation_tool")
  @@index([serverId, status])
  @@index([installationId, status])
  @@index([snapshotHash])
}

model McpToolInvocation {
  id             String    @id @default(cuid())
  runtimeToolId  String
  serverId       String
  installationId String?   @map("installation_id")
  toolSnapshotId String
  tenantId       String?
  userId         String
  agentId        String?
  conversationId String?   @map("conversation_id")
  turnId         String?   @map("turn_id")
  workflowId     String?   @map("workflow_id")
  stepId         String?   @map("step_id")
  requestId      String?   @map("request_id")
  traceId        String?
  status         String
  arguments      Json      @default("{}")
  result         Json?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  server       McpServerConfig  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  installation McpInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  snapshot     McpToolSnapshot  @relation(fields: [toolSnapshotId], references: [id], onDelete: Restrict)

  @@index([runtimeToolId])
  @@index([serverId, status])
  @@index([installationId, status])
  @@index([tenantId, userId])
  @@index([conversationId, turnId])
  @@index([traceId])
}

model McpAuditLog {
  id            String   @id @default(cuid())
  eventType     String
  serverId      String?
  runtimeToolId String?
  tenantId      String?
  userId        String?
  agentId       String?
  traceId       String?
  severity      String
  code          String?
  message       String?
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([serverId])
  @@index([runtimeToolId])
  @@index([tenantId, userId])
  @@index([traceId])
}


model RuntimeEventOutbox {
  id               String    @id @default(cuid())
  eventId          String    @unique @map("event_id") @db.VarChar(180)
  eventType        String    @map("event_type") @db.VarChar(160)
  aggregateType    String    @map("aggregate_type") @db.VarChar(80)
  aggregateId      String    @map("aggregate_id") @db.VarChar(180)
  payloadJson      Json      @map("payload_json")
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(300)
  status           String    @default("pending") @db.VarChar(40)
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at")
  claimedBy        String?   @map("claimed_by") @db.VarChar(180)
  claimExpiresAt   DateTime? @map("claim_expires_at")
  deliveredAt      DateTime? @map("delivered_at")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt], map: "idx_runtime_outbox_pending")
  @@index([aggregateId, createdAt], map: "idx_runtime_outbox_aggregate")
  @@index([claimExpiresAt], map: "idx_runtime_outbox_claim_expiry")
  @@map("runtime_event_outbox")
}

model RuntimeTimelineEvent {
  id                       String   @id @default(cuid())
  eventId                  String   @unique @map("event_id") @db.VarChar(180)
  conversationId           String   @map("conversation_id")
  presentationMessageId    String   @map("presentation_message_id") @db.VarChar(180)
  sourceAssistantMessageId String?  @map("source_assistant_message_id") @db.VarChar(180)
  traceId                  String?  @map("trace_id") @db.VarChar(180)
  workflowId               String?  @map("workflow_id") @db.VarChar(180)
  identityKey              String   @map("identity_key") @db.VarChar(260)
  version                  Int      @default(1)
  sequence                 BigInt   @default(autoincrement())
  type                     String   @db.VarChar(120)
  payloadJson              Json     @map("payload_json")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([presentationMessageId, identityKey, version], map: "uq_runtime_timeline_presentation_identity_version")
  @@index([conversationId, sequence], map: "idx_runtime_timeline_conversation_sequence")
  @@index([presentationMessageId, sequence], map: "idx_runtime_timeline_presentation_sequence")
  @@index([workflowId, sequence], map: "idx_runtime_timeline_workflow_sequence")
  @@map("runtime_timeline_event")
}


enum WorkflowRunStatus {
  RUNNING
  WAITING
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowWaitReason {
  CONTINUATION
  USER_INPUT
  APPROVAL
  EXTERNAL_DEPENDENCY
  RESOURCE_CONFLICT
}

enum WorkflowContinuationMode {
  MANUAL
  AUTO
}

enum WorkflowPhaseStatus {
  PENDING
  ACTIVE
  COMPLETED
  BLOCKED
  FAILED
  SKIPPED
  CANCELLED
}

enum WorkflowTurnTrigger {
  USER
  AUTO
  RESUME
  RECOVERY
}

enum RuntimePermissionMode {
  confirm_required
  audit_autorun
  full_access
}

enum RuntimeApprovalScopeType {
  TURN
  WORKFLOW
}

enum RuntimeRiskLevel {
  low
  medium
  high
  forbidden
}

model WorkflowRun {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  agentId              String   @map("agent_id")
  conversationId       String   @map("conversation_id")
  branchId             String?  @map("branch_id") @db.VarChar(180)
  workspaceId          String?  @map("workspace_id")
  initialUserMessageId String   @map("initial_user_message_id") @db.VarChar(180)
  inputObjectIds       String[] @default([]) @map("input_object_ids")

  title        String @db.VarChar(256)
  goal         String @db.Text
  contractJson Json   @default("{}") @map("contract_json")

  status           WorkflowRunStatus        @default(RUNNING)
  waitReason       WorkflowWaitReason?      @map("wait_reason")
  continuationMode WorkflowContinuationMode @default(MANUAL) @map("continuation_mode")
  permissionMode   RuntimePermissionMode    @default(confirm_required) @map("permission_mode")
  currentPhaseId   String?                  @map("current_phase_id") @db.VarChar(180)

  leaseOwner     String?   @map("lease_owner") @db.VarChar(180)
  leaseExpiresAt DateTime? @map("lease_expires_at")
  fencingToken   BigInt    @default(0) @map("fencing_token")
  version        Int       @default(1)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  cancelledAt DateTime? @map("cancelled_at")

  user         User              @relation("WorkflowRunUser", fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent             @relation("WorkflowRunAgent", fields: [agentId], references: [id], onDelete: Restrict)
  conversation Conversation      @relation("WorkflowRunConversation", fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    RuntimeWorkspace? @relation("WorkflowRunWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)

  phases    WorkflowPhase[]
  turnLinks WorkflowTurnLink[]
  events    WorkflowEvent[]

  @@index([userId, agentId, conversationId, status], map: "idx_workflow_run_scope_status")
  @@index([conversationId, updatedAt], map: "idx_workflow_run_conversation_updated")
  @@index([workspaceId, status], map: "idx_workflow_run_workspace_status")
  @@index([status, leaseExpiresAt], map: "idx_workflow_run_recovery")
  @@map("workflow_run")
}

model WorkflowPhase {
  id             String              @id @default(cuid())
  workflowId     String              @map("workflow_id")
  parentPhaseId  String?             @map("parent_phase_id")
  title          String              @db.VarChar(256)
  description    String?             @db.Text
  status         WorkflowPhaseStatus @default(PENDING)
  position       Int
  dependencyIds  String[]            @default([]) @map("dependency_ids")
  acceptanceJson Json?               @map("acceptance_json")
  resultSummary  String?             @map("result_summary") @db.Text
  resultJson     Json?               @map("result_json")
  startedAt      DateTime?           @map("started_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workflow  WorkflowRun        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  parent    WorkflowPhase?     @relation("WorkflowPhaseTree", fields: [parentPhaseId], references: [id], onDelete: SetNull)
  children  WorkflowPhase[]    @relation("WorkflowPhaseTree")
  turnLinks WorkflowTurnLink[]
  events    WorkflowEvent[]

  @@index([workflowId, position], map: "idx_workflow_phase_position")
  @@index([workflowId, status, position], map: "idx_workflow_phase_status_position")
  @@index([workflowId, parentPhaseId, position], map: "idx_workflow_phase_parent_position")
  @@map("workflow_phase")
}

model WorkflowTurnLink {
  id                 String              @id @default(cuid())
  workflowId         String              @map("workflow_id")
  phaseId            String?             @map("phase_id")
  traceId            String              @unique @map("trace_id") @db.VarChar(180)
  userMessageId      String?             @map("user_message_id") @db.VarChar(180)
  assistantMessageId String?             @map("assistant_message_id") @db.VarChar(180)
  trigger            WorkflowTurnTrigger @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at")

  workflow WorkflowRun    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  phase    WorkflowPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([workflowId, createdAt], map: "idx_workflow_turn_link_workflow")
  @@index([phaseId, createdAt], map: "idx_workflow_turn_link_phase")
  @@map("workflow_turn_link")
}

model WorkflowEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique @map("event_id") @db.VarChar(180)
  workflowId       String   @map("workflow_id")
  phaseId          String?  @map("phase_id")
  sequence         Int
  type             String   @db.VarChar(160)
  payloadJson      Json     @map("payload_json")
  deduplicationKey String   @unique @map("deduplication_key") @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at")

  workflow WorkflowRun    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  phase    WorkflowPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@unique([workflowId, sequence], map: "uq_workflow_event_sequence")
  @@index([workflowId, createdAt], map: "idx_workflow_event_created")
  @@index([type, createdAt], map: "idx_workflow_event_type")
  @@map("workflow_event")
}

model AgentTurn {
  id                  String                @id @default(cuid())
  traceId             String                @unique @map("trace_id") @db.VarChar(180)
  userId              String                @map("user_id") @db.VarChar(120)
  agentId             String                @map("agent_id") @db.VarChar(120)
  conversationId      String                @map("conversation_id") @db.VarChar(120)
  userMessageId       String                @unique @map("user_message_id") @db.VarChar(180)
  assistantMessageId  String                @unique @map("assistant_message_id") @db.VarChar(180)
  status              String                @default("running") @db.VarChar(40)
  kernelSessionId     String                @map("kernel_session_id") @db.VarChar(180)
  workspaceId         String?               @map("workspace_id")
  permissionMode      RuntimePermissionMode @default(confirm_required) @map("permission_mode")
  accessPolicyVersion Int                   @default(1) @map("access_policy_version")
  requestJson         Json?                 @map("request_json")
  resultJson          Json?                 @map("result_json")
  errorJson           Json?                 @map("error_json")
  startedAt           DateTime              @default(now()) @map("started_at")
  completedAt         DateTime?             @map("completed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  inputs      AgentTurnInput[]
  events      AgentTurnEvent[]
  checkpoints AgentTurnCheckpoint[]
  approvals   AgentApproval[]

  @@index([userId, conversationId], map: "idx_agent_turn_owner")
  @@index([conversationId, startedAt], map: "idx_agent_turn_conversation_time")
  @@index([conversationId, status, startedAt], map: "idx_agent_turn_active_scope")
  @@index([workspaceId, status], map: "idx_agent_turn_workspace_status")
  @@index([status], map: "idx_agent_turn_status")
  @@map("agent_turn")
}

model AgentTurnCheckpoint {
  id                String   @id @default(cuid())
  turnId            String   @map("turn_id")
  stateJson         Json     @map("state_json")
  pendingToolCallId String?  @map("pending_tool_call_id") @db.VarChar(180)
  pendingApprovalId String?  @map("pending_approval_id") @db.VarChar(180)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  turn AgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId, createdAt], map: "idx_agent_turn_checkpoint_turn")
  @@index([pendingApprovalId], map: "idx_agent_turn_checkpoint_approval")
  @@map("agent_turn_checkpoint")
}

model AgentApproval {
  id                     String                   @id @default(cuid())
  approvalId             String                   @unique @map("approval_id") @db.VarChar(180)
  turnId                 String                   @map("turn_id")
  traceId                String                   @map("trace_id") @db.VarChar(180)
  userId                 String                   @map("user_id") @db.VarChar(120)
  agentId                String                   @map("agent_id") @db.VarChar(120)
  conversationId         String                   @map("conversation_id") @db.VarChar(120)
  assistantMessageId     String                   @map("assistant_message_id") @db.VarChar(180)
  toolCallId             String?                  @map("tool_call_id") @db.VarChar(180)
  toolName               String                   @map("tool_name") @db.VarChar(180)
  scopeType              RuntimeApprovalScopeType @map("scope_type")
  scopeId                String                   @map("scope_id") @db.VarChar(180)
  workflowId             String?                  @map("workflow_id") @db.VarChar(180)
  phaseId                String?                  @map("phase_id") @db.VarChar(180)
  stepId                 String?                  @map("step_id") @db.VarChar(180)
  iteration              Int?
  riskLevel              RuntimeRiskLevel         @map("risk_level")
  descriptorHash         String                   @map("descriptor_hash") @db.VarChar(128)
  policyVersionAtRequest Int                      @map("policy_version_at_request")
  permissionMode         RuntimePermissionMode    @map("permission_mode")
  status                 String                   @default("pending") @db.VarChar(40)
  decision               String?                  @db.VarChar(40)
  requestJson            Json                     @map("request_json")
  errorJson              Json?                    @map("error_json")
  decidedAt              DateTime?                @map("decided_at")
  resumedAt              DateTime?                @map("resumed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  turn AgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "idx_agent_approval_user_status")
  @@index([turnId, status], map: "idx_agent_approval_turn_status")
  @@index([scopeType, scopeId, status], map: "idx_agent_approval_scope_status")
  @@index([workflowId, status], map: "idx_agent_approval_workflow_status")
  @@index([stepId, createdAt], map: "idx_agent_approval_step_time")
  @@index([descriptorHash], map: "idx_agent_approval_descriptor")
  @@index([conversationId, createdAt], map: "idx_agent_approval_conversation")
  @@map("agent_approval")
}

// User inputs retain product identity while the journal retains execution order.
model AgentTurnInput {
  id            String   @id @default(cuid())
  turnId        String   @map("turn_id")
  clientInputId String   @map("client_input_id")
  sequence      Int
  kind          String   @db.VarChar(40)
  content       String
  objectRefs    Json     @map("object_refs")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  turn          AgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  @@unique([turnId, clientInputId])
  @@unique([turnId, sequence])
  @@index([turnId, consumedAt])
  @@map("agent_turn_input")
}

model AgentTurnEvent {
  id          String   @id @default(cuid())
  turnId      String   @map("turn_id")
  sequence    Int
  kind        String   @db.VarChar(80)
  iteration   Int
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")
  turn        AgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  @@unique([turnId, sequence])
  @@index([turnId, kind])
  @@map("agent_turn_event")
}
