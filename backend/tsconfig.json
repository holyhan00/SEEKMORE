{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "strictNullChecks": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "skipLibCheck": true,
    "incremental": true,
    "paths": {
      "@prisma/client": [
        "node_modules/@prisma/client"
      ]
    },
    "types": [
      "node"
    ]
  }
}