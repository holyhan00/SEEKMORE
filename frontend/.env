# SEEKMORE frontend local development configuration

# Canonical backend API root. Must include /api.
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# Backend origin used for files, artifacts, and non-API resources.
VITE_BACKEND_BASE_URL=http://127.0.0.1:3000

# Socket.IO / WebSocket backend origin.
VITE_WS_BASE_URL=http://127.0.0.1:3000

# Vite development proxy target for requests using relative /api paths.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
